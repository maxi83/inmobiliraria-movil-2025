<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/nav_inicio">

    <!-- Inicio -->
    <fragment
        android:id="@+id/nav_inicio"
        android:name="com.example.inmobiliaria_2025.ui.inicio.InicioFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_inicio">
        <action
            android:id="@+id/action_nav_inicio_to_nav_inmuebles"
            app:destination="@id/nav_inmuebles" />
        <action
            android:id="@+id/action_nav_inicio_to_nav_perfil"
            app:destination="@id/nav_perfil" />
    </fragment>

    <!-- Perfil -->
    <fragment
        android:id="@+id/nav_perfil"
        android:name="com.example.inmobiliaria_2025.ui.perfil.PerfilFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_perfil" />

    <!-- Inmuebles -->
    <fragment
        android:id="@+id/nav_inmuebles"
        android:name="com.example.inmobiliaria_2025.ui.inmueble.InmueblesFragment"
        android:label="Inmuebles"
        tools:layout="@layout/fragment_inmuebles">
        <action
            android:id="@+id/action_nav_inmuebles_to_detalleInmuebleFragment"
            app:destination="@id/detalleInmuebleFragment" />
        <action
            android:id="@+id/action_nav_inmuebles_to_cargarInmuebleFragment"
            app:destination="@id/cargarInmuebleFragment" />
    </fragment>

    <!-- Cargar Inmueble -->
    <fragment
        android:id="@+id/cargarInmuebleFragment"
        android:name="com.example.inmobiliaria_2025.ui.inmueble.CargarInmuebleFragment"
        android:label="Cargar Inmueble"
        tools:layout="@layout/fragment_cargar_inmueble" />

    <!-- Detalle Inmueble -->
    <fragment
        android:id="@+id/detalleInmuebleFragment"
        android:name="com.example.inmobiliaria_2025.ui.inmueble.DetalleInmuebleFragment"
        android:label="Detalle Inmueble"
        tools:layout="@layout/fragment_detalle_inmueble">
        <action
            android:id="@+id/action_detalleInmuebleFragment_to_nav_inmuebles"
            app:destination="@id/nav_inmuebles" />
    </fragment>

    <!-- Inquilinos -->
    <fragment
        android:id="@+id/nav_inquilinos"
        android:name="com.example.inmobiliaria_2025.ui.inquilino.InquilinoFragment"
        android:label="Inquilinos"
        tools:layout="@layout/fragment_inquilinos">
        <action
            android:id="@+id/action_nav_inquilinos_to_detalleInquilinoFragment"
            app:destination="@id/detalleInquilinoFragment" />
        <action
            android:id="@+id/action_nav_inquilinos_to_detalleInmuebleFragment"
            app:destination="@id/detalleInmuebleFragment"/>
    </fragment>

    <!-- Detalle Inquilino -->
    <fragment
        android:id="@+id/detalleInquilinoFragment"
        android:name="com.example.inmobiliaria_2025.ui.inquilino.DetalleInquilinoFragment"
        android:label="Detalle Inquilino"
        tools:layout="@layout/fragment_detalle_inquilino" />

    <!-- Contratos -->
    <fragment
        android:id="@+id/nav_contratos"
        android:name="com.example.inmobiliaria_2025.ui.contrato.ContratoFragment"
        android:label="Contratos"
        tools:layout="@layout/fragment_contratos">
        <!-- Acción que faltaba -->
        <action
            android:id="@+id/action_nav_contratos_to_detalleContratoFragment"
            app:destination="@id/detalleContratoFragment" />
    </fragment>

    <!-- Detalle Contrato -->
    <fragment
        android:id="@+id/detalleContratoFragment"
        android:name="com.example.inmobiliaria_2025.ui.contrato.DetalleContratoFragment"
        android:label="Detalle Contrato"
        tools:layout="@layout/fragment_detalle_contrato">
        <argument
            android:name="contrato"
            app:argType="com.example.inmobiliaria_2025.model.Contrato"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_detalleContratoFragment_to_detalleInquilinoFragment"
            app:destination="@id/detalleInquilinoFragment" />
        <action
            android:id="@+id/action_detalleContratoFragment_to_pagosFragment"
            app:destination="@id/pagosFragment" />
    </fragment>

    <!-- Pagos -->
    <fragment
        android:id="@+id/pagosFragment"
        android:name="com.example.inmobiliaria_2025.ui.pagos.PagosFragment"
        android:label="Pagos"
        tools:layout="@layout/fragment_pagos" />

    <!-- Logout -->
    <fragment
        android:id="@+id/nav_logout"
        android:name="com.example.inmobiliaria_2025.ui.logout.LogoutFragment"
        android:label="Logout"
        tools:layout="@layout/fragment_logout" />

</navigation>
